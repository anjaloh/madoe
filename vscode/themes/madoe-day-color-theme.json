  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#909090",
        "fontStyle": "italic"
      }
    },
    {
      "name": "comment.doc",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#7d4bc6",
        "fontStyle": ""
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#5580a8",
        "fontStyle": ""
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#378e23",
        "fontStyle": ""
      }
    },
    {
      "name": "string.escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder"
      ],
      "settings": {
        "foreground": "#5580a8",
        "fontStyle": ""
      }
    },
    {
      "name": "string.regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#0c947c",
        "fontStyle": ""
      }
    },
    {
      "name": "string.special.symbol",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#378e23",
        "fontStyle": ""
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#c3691e",
        "fontStyle": ""
      }
    },
    {
      "name": "boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language"
      ],
      "settings": {
        "foreground": "#c3691e",
        "fontStyle": ""
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#c3691e",
        "fontStyle": ""
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#2f64d2",
        "fontStyle": ""
      }
    },
    {
      "name": "constructor",
      "scope": [
        "entity.name.function.constructor",
        "new.expr entity.name.type"
      ],
      "settings": {
        "foreground": "#2f64d2",
        "fontStyle": ""
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#0f87a2",
        "fontStyle": ""
      }
    },
    {
      "name": "enum",
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#c3691e",
        "fontStyle": ""
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#cd3048",
        "fontStyle": ""
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "meta.attribute",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#7d4bc6",
        "fontStyle": ""
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#444444",
        "fontStyle": ""
      }
    },
    {
      "name": "variable.special",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#cd3048",
        "fontStyle": ""
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "entity.name.tag.toml"
      ],
      "settings": {
        "foreground": "#0082aa",
        "fontStyle": ""
      }
    },
    {
      "name": "label",
      "scope": [
        "entity.name.label",
        "punctuation.definition.label"
      ],
      "settings": {
        "foreground": "#0082aa",
        "fontStyle": ""
      }
    },
    {
      "name": "preproc",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#0c947c",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#5580a8",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation.bracket",
      "scope": [
        "punctuation.section",
        "punctuation.bracket",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.array"
      ],
      "settings": {
        "foreground": "#4a72b0",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation.delimiter",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#5580a8",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation.special",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#5580a8",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation.list_marker",
      "scope": [
        "punctuation.definition.list",
        "markup.list punctuation.definition"
      ],
      "settings": {
        "foreground": "#4a72b0",
        "fontStyle": ""
      }
    },
    {
      "name": "embedded",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#444444",
        "fontStyle": ""
      }
    },
    {
      "name": "string.special",
      "scope": [
        "string.other.link",
        "string.unquoted.heredoc"
      ],
      "settings": {
        "foreground": "#c3691e",
        "fontStyle": ""
      }
    },
    {
      "name": "title",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#0a8e70",
        "fontStyle": "bold"
      }
    },
    {
      "name": "emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#444444",
        "fontStyle": "italic"
      }
    },
    {
      "name": "emphasis.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#444444",
        "fontStyle": "bold"
      }
    },
    {
      "name": "link_text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#0c947c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "link_uri",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0c947c",
        "fontStyle": ""
      }
    },
    {
      "name": "text.literal",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#0f87a2",
        "fontStyle": ""
      }
    }
