  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#51597d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "comment.doc",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#5a638c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#bb9af7",
        "fontStyle": ""
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": ""
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9ece6a",
        "fontStyle": ""
      }
    },
    {
      "name": "string.escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder"
      ],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": ""
      }
    },
    {
      "name": "string.regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b4f9f8",
        "fontStyle": ""
      }
    },
    {
      "name": "string.special.symbol",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9ece6a",
        "fontStyle": ""
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ff9e64",
        "fontStyle": ""
      }
    },
    {
      "name": "boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ff9e64",
        "fontStyle": ""
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ff9e64",
        "fontStyle": ""
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7aa2f7",
        "fontStyle": ""
      }
    },
    {
      "name": "constructor",
      "scope": [
        "entity.name.function.constructor",
        "new.expr entity.name.type"
      ],
      "settings": {
        "foreground": "#7aa2f7",
        "fontStyle": ""
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#0db9d7",
        "fontStyle": ""
      }
    },
    {
      "name": "enum",
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#ff9e64",
        "fontStyle": ""
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#f7768e",
        "fontStyle": ""
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "meta.attribute",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#bb9af7",
        "fontStyle": ""
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#c8c8c8",
        "fontStyle": ""
      }
    },
    {
      "name": "variable.special",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#f7768e",
        "fontStyle": ""
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "entity.name.tag.toml"
      ],
      "settings": {
        "foreground": "#7dcfff",
        "fontStyle": ""
      }
    },
    {
      "name": "label",
      "scope": [
        "entity.name.label",
        "punctuation.definition.label"
      ],
      "settings": {
        "foreground": "#7dcfff",
        "fontStyle": ""
      }
    },
    {
      "name": "preproc",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#73daca",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation.bracket",
      "scope": [
        "punctuation.section",
        "punctuation.bracket",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.array"
      ],
      "settings": {
        "foreground": "#9abdf5",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation.delimiter",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation.special",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation.list_marker",
      "scope": [
        "punctuation.definition.list",
        "markup.list punctuation.definition"
      ],
      "settings": {
        "foreground": "#9abdf5",
        "fontStyle": ""
      }
    },
    {
      "name": "embedded",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#c8c8c8",
        "fontStyle": ""
      }
    },
    {
      "name": "string.special",
      "scope": [
        "string.other.link",
        "string.unquoted.heredoc"
      ],
      "settings": {
        "foreground": "#ff9e64",
        "fontStyle": ""
      }
    },
    {
      "name": "title",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#1abc9c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#c8c8c8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "emphasis.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#c8c8c8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "link_text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#73daca",
        "fontStyle": "italic"
      }
    },
    {
      "name": "link_uri",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#73daca",
        "fontStyle": ""
      }
    },
    {
      "name": "text.literal",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#3a95ab",
        "fontStyle": ""
      }
    }
  ],
