{
  "name": "madoe",
  "version": "0.1.0",
  "private": true,
  "description": "Madoe Night and Day themes for Zed, Ghostty, and VS Code",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "check": "node build.ts --check",
    "test": "node --test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "mutate": "stryker run",
    "typecheck": "tsc --noEmit",
    "package:vscode": "node build.ts && mkdir -p dist && cd vscode && bunx @vscode/vsce package --allow-missing-repository --no-rewrite-relative-links --out ../dist/madoe-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5",
    "qs": "^6.17.1"
  },
  "engines": {
    "node": ">=26"
  }
}
